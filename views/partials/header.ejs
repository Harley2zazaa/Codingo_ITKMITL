<div class="min-[769px]:block">
    <div class="bg-white flex justify-between border-b px-6 py-3 fixed top-0 w-full">
        <a href="/" class="flex items-center"><img src="/img/codingo_logo.png" class="h-10 w-auto"></a>
        <div class="flex items-center gap-4">
            <a href="/course" class="text-gray-800 text-sm">บทเรียน</a>
            <% if (user) { %>
            <a href="/library" class="text-gray-800 text-sm">คลัง</a>
            <a href="/progression" class="text-gray-800 text-sm">ความก้าวหน้า</a>
            <% if (user.role == "student" || user.role == "instructor") { %>
            <a href="/leaderboard" class="text-gray-800 text-sm">อันดับ</a>
            <% } if (user.role == "instructor") { %>
            <a href="/instructor" class="text-gray-800 text-sm">จัดการบทเรียน</a>
            <% } else if (user.role == "admin") { %>
            <a href="/admin" class="text-gray-800 text-sm">จัดการบัญชี</a>
            <% } %>
            <a href="/profile" class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-800 text-white text-xs"><%= user.username[0].toUpperCase() %></a>
            <% } else { %>
            <a href="/signin" class="px-4 py-3 bg-gray-800 text-white text-xs rounded-xl">ลงชื่อเข้าใช้</a>
            <% } %>
        </div>
    </div>
</div>
<div class="min-[769px]:hidden">
    <div class="bg-white flex justify-between border-b px-6 py-3 fixed top-0 w-full">
        <a href="/" class="flex items-center"><img src="/img/codingo_logo.png" class="h-10 w-auto"></a>
        <div class="flex items-center gap-4">
            <% if (user) { %>
            <input type="checkbox" id="hamburger" class="hidden peer">
            <label for="hamburger" class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-800 text-white text-xs"><%= user.username[0].toUpperCase() %></label>
            <div class="absolute right-4 top-20 w-48 bg-white border rounded-xl shadow-md p-2 hidden peer-checked:block">
                <a href="/course" class="block px-4 py-2 text-gray-800 text-sm">บทเรียน</a>
                <a href="/library" class="block px-4 py-2 text-gray-800 text-sm">คลัง</a>
                <a href="/progression" class="block px-4 py-2 text-gray-800 text-sm">ความก้าวหน้า</a>
                <% if (user.role == "student" || user.role == "instructor") { %>
                <a href="/leaderboard" class="block px-4 py-2 text-gray-800 text-sm">อันดับ</a>
                <% } if (user.role == "instructor") { %>
                <a href="/instructor" class="block px-4 py-2 text-gray-800 text-sm">จัดการบทเรียน</a>
                <% } else if (user.role == "admin") { %>
                <a href="/admin" class="block px-4 py-2 text-gray-800 text-sm">จัดการบัญชี</a>
                <% } %>
                <hr class="my-2">
                <a href="/profile" class="block px-4 py-2 text-gray-800 text-sm">โปรไฟล์</a>
            </div>
            <% } else { %>
            <a href="/course" class="text-gray-800 text-sm">บทเรียน</a>
            <a href="/signin" class="px-4 py-3 bg-gray-800 text-white text-xs rounded-xl">ลงชื่อเข้าใช้</a>
            <% } %>
        </div>
    </div>
</div>
