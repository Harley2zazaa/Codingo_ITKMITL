<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head") %>
    <title>หน้าหลัก - Codingo</title>
</head>
<body class="bg-white">
    <%- include("partials/header") %>
    <div class="flex justify-center items-center px-6 text-center min-h-screen">
        <div class="max-w-3xl">
            <img src="/img/codingo_logo.png" class="h-24 mx-auto">
            <p class="text-gray-600 text-lg max-w-2xl mb-6 mx-auto">ระบบจัดการเรียนรู้ทักษะการเขียนโปรแกรมคอมพิวเตอร์สำหรับการศึกษาและพัฒนาตนเอง</p>
            <div class="flex gap-4 justify-center">
                <% if (user) { %>
                <% if (user.role == "student") { %>
                <a href="/library" class="bg-gray-800 text-white px-4 py-3 rounded-xl text-sm">คลังของฉัน</a>
                <% } else if (user.role == "instructor") { %>
                <a href="/instructor" class="bg-gray-800 text-white px-4 py-3 rounded-xl text-sm">จัดการบทเรียน</a>
                <% } else if (user.role == "admin") { %>
                <a href="/admin" class="bg-gray-800 text-white px-4 py-3 rounded-xl text-sm">จัดการบัญชี</a>
                <% } %>
                <% } else { %>
                <a href="/signin" class="bg-gray-800 text-white px-4 py-3 rounded-xl text-sm">เริ่มเรียนเลย</a>
                <% } %>
                <a href="/course" class="border px-4 py-3 rounded-xl text-sm">ค้นหาบทเรียน</a>
            </div>
        </div>
    </div>
    <%- include("partials/footer") %>
</body>
</html>
